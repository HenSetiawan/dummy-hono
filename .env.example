# Port yang didengarkan DUMMY-API (compose memetakan host 9000 -> container 9000).
PORT=9000

# Jumlah proses Bun: 1 (default), `auto` (= jumlah core), atau angka 1-64.
# >1 memakai SO_REUSEPORT; hanya efektif di Linux/container.
API_PROCS=auto

# Flag `Bun.serve({ reusePort })` (SO_REUSEPORT): `auto` (menyala kalau API_PROCS>1),
# `1` (selalu), atau `0` (selalu mati). `1` dipakai untuk clustering lintas container:
# API_PROCS=1 + REUSE_PORT=1 di beberapa replika yang berbagi port (network_mode: host).
REUSE_PORT=auto

# 1 = log satu baris per request ke stdout (untuk debugging; memotong throughput).
ACCESS_LOG=0
